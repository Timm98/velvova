# ══════════════════════════════════════════════════════════════
# Velvova — Umgebungsvariablen
# ══════════════════════════════════════════════════════════════
#
# Diese Datei enthält AUSSCHLIESSLICH leere Platzhalter. Sie wird
# versioniert; `.env` und `.env.local` nicht. Wer hier einen echten
# Wert einträgt, veröffentlicht ihn.

# ── Anwendung ─────────────────────────────────────────────────
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_PORT=3000

# ── Datenbank ─────────────────────────────────────────────────
# pglite = eingebettet (Entwicklung, Tests) · pg = echter Server
DATABASE_DRIVER=pg
DATABASE_URL=

# ── Anmeldung ─────────────────────────────────────────────────
AUTH_COOKIE_NAME=paycheck_session
AUTH_SECRET=

# ── E-Mail-Versand ────────────────────────────────────────────
#
# draft  = es geht nichts hinaus, der Inhalt landet auf der
#          Serverkonsole. NUR für die lokale Entwicklung; in der
#          Produktion bricht der Versand mit einem
#          Konfigurationsfehler ab, statt still zu verschwinden.
# resend = echter Versand über Resend.
MAIL_PROVIDER=resend

# Der Schlüssel aus dem Resend-Konto. Trägt bewusst kein
# NEXT_PUBLIC_: Wer ihn hat, versendet Mails im Namen der
# verifizierten Absenderdomain.
RESEND_API_KEY=
# Signatur der Zustellereignisse (Webhook). Ohne sie nimmt /api/webhooks/mail nichts an.
MAIL_WEBHOOK_SECRET=

# Was ein Modellaufruf kostet, in Cent je eine Million Tokens.
# Ohne diese Werte rechnet das Budget mit einer bewusst hohen
# Vorgabe — es bremst dann eher zu frueh als zu spaet.
AI_PREIS_INPUT_CENT_PRO_MTOKEN=
AI_PREIS_OUTPUT_CENT_PRO_MTOKEN=

# Die Absenderadresse. Ihre Domain muss in Resend verifiziert sein,
# sonst lehnt der Dienst jeden Versand ab.
# Format: "Velvova <noreply@velvova.com>"
MAIL_FROM=

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur serverseitig. Umgeht die Zeilenrichtlinien.
SUPABASE_SECRET_KEY=

# ── Sprachmodell ──────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=

# ── Wartung ───────────────────────────────────────────────────
# Das Geheimnis für den Stellenabruf und den Vorschlagslauf.
JOBS_REFRESH_SECRET=

# ── Nur für die lokale Entwicklung ────────────────────────────
# Ein passwortloser Anmeldeendpunkt. Ohne diesen Schalter
# antwortet er mit 404, als gäbe es ihn nicht.
DEV_LOGIN_ENABLED=
