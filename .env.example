# Kopiere nach .env und fuelle aus. Niemals .env committen.
# Ohne einen einzigen Schluessel laeuft das Projekt vollstaendig im Demo-Modus.

# ---------- Marke ----------
# Beide Namen sind vorlaeufig und ueberall aus dieser Konfiguration bezogen.
NEXT_PUBLIC_BRAND_NAME=Paycheck
NEXT_PUBLIC_ASSISTANT_NAME=Nina

# ---------- Betriebsmodus ----------
# demo  = ausschliesslich synthetische Daten, kein echter Versand, Mock-KI
# live  = echte Adapter, sofern konfiguriert
PAYCHECK_DEMO_MODE=demo

# ---------- Datenbank ----------
# pglite = eingebettetes Postgres, kein Docker noetig (Standard fuer lokal)
# pg     = echter Postgres-Server (Produktion)
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite
# DATABASE_URL=postgres://user:pass@localhost:5432/paycheck

# ---------- Auth ----------
# Zufaellig erzeugen: openssl rand -base64 32
AUTH_SECRET=
AUTH_COOKIE_NAME=paycheck_session

# ---------- KI ----------
# mock      = deterministischer lokaler Provider, kein Netz, keine Kosten
# anthropic = echter Provider, benoetigt ANTHROPIC_API_KEY
AI_PROVIDER=mock
# openai | anthropic | self_hosted | mock
# Ohne passenden Schluessel laeuft der lokale Demo-Anbieter, und die
# Oberflaeche sagt das ausdruecklich - sie taeuscht keinen Betrieb vor.
OPENAI_API_KEY=
# Vier Stufen: Gespraech, Tiefenanalyse, Klassifikation, Sprache.
OPENAI_MODEL_INTERACTIVE=gpt-5.6-terra
OPENAI_MODEL_DEEP=gpt-5.6-sol
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_SPEECH_MODEL=
OPENAI_SPEECH_VOICE=
# Selbst betriebener, OpenAI-kompatibler Endpunkt
SELF_HOSTED_BASE_URL=
SELF_HOSTED_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_STRONG=claude-opus-5
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_EMBED=local-hash-embedding
AI_MAX_TOKENS_PER_RUN=4096
AI_TIMEOUT_MS=60000
AI_MONTHLY_BUDGET_EUR=0

# ---------- Sprache / Voice ----------
# mock = Browser-SpeechRecognition bzw. Texteingabe als Rueckfallweg
VOICE_PROVIDER=mock
VOICE_STORE_TRANSCRIPTS=false

# ---------- E-Mail-Versand ----------
# draft   = erzeugt nur Entwuerfe zum Download (Standard, versendet nichts)
# mailpit = lokaler SMTP-Testserver
# gmail / outlook = OAuth, erst nach Verbindung im Privacy Center aktiv
MAIL_PROVIDER=draft
SMTP_URL=smtp://localhost:1025
MAIL_FROM=

# ---------- Objektspeicher ----------
# local = verschluesselte Dateien unter .storage (Standard)
# s3    = S3-kompatibel, EU-Region
STORAGE_DRIVER=local
STORAGE_DIR=.storage
STORAGE_ENCRYPTION_KEY=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------- Jobquellen ----------
# seed = synthetische Demo-Stellen. Weitere Adapter nur mit gueltiger Lizenz.
JOB_SOURCES=arbeitnow,user_text,seed
# JOB_API_KEY=

# ---------- Bewertungsquellen ----------
# none = keine externen Reviews. Nur lizenzierte APIs oder Deep Links.
REVIEW_SOURCES=seed
# GOOGLE_PLACES_API_KEY=
# KUNUNU_API_KEY=

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=3000

# Geheimnis fuer den planmaessigen Stellenabruf (POST /api/jobs/refresh)
JOBS_REFRESH_SECRET=

# ── Supabase ──────────────────────────────────────────────────
# Ohne diese Werte laeuft die eingebettete Datenbank, und die
# Oberflaeche sagt das ausdruecklich - sie taeuscht keine Verbindung vor.
#
# Lokal (braucht Docker):   supabase start
# Remote:                   supabase link && supabase db push
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Umgeht RLS. Ausschliesslich serverseitig, niemals mit NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
