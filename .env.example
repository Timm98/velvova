# ═══════════════════════════════════════════════════════════════
# Paycheck — Umgebungsvariablen
# ═══════════════════════════════════════════════════════════════
#
# Diese Datei enthält ausschließlich leere Platzhalter und wird
# versioniert. Echte Werte gehören in .env.local — die Datei ist
# ignoriert und darf niemals eingecheckt werden.
#
# Nur NEXT_PUBLIC_* erreicht den Browser. Alles andere bleibt
# serverseitig; der Dienstschlüssel und jeder Anbieterschlüssel
# insbesondere.
#
# Fehlt eine Variable, meldet die Anwendung beim Start ihren NAMEN —
# niemals einen Wert.

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Öffentlich, absichtlich: dieser Schlüssel wird an den Browser
# ausgeliefert. Row Level Security ist der Schutz, nicht seine
# Geheimhaltung.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Umgeht Row Level Security. Ausschließlich serverseitig.
# Der ältere Name SUPABASE_SERVICE_ROLE_KEY wird weiterhin gelesen.
SUPABASE_SECRET_KEY=
# Direkte Datenbankverbindung für Migrationen. Enthält das Passwort.
DATABASE_URL=

# ── OpenAI ────────────────────────────────────────────────────
# Ein Projektschlüssel, mehrere Modelle. Die Zuordnung Aufgabe →
# Modell steht im Router, nicht im Fachcode.
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-5.6-terra
OPENAI_MODEL_DEEP=gpt-5.6-sol
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_REALTIME=gpt-realtime-2.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# GEPLANT — noch nicht implementiert.
# Web-Suche wäre eine Entdeckungsebene für Arbeitgeber-Karriereseiten,
# keine Rechtsgrundlage zum Kopieren fremder Inhalte.
# OPENAI_WEB_SEARCH_ENABLED=false
# OPENAI_WEB_SEARCH_MODEL=gpt-5.6-terra

# ── Anwendungsseitige Verschlüsselung und Signierung ──────────
# GEPLANT — noch nicht implementiert. Die Verschlüsselung besonders
# schutzbedürftiger Freitexte ist in docs/DPIA_DRAFT.md als offenes
# Restrisiko geführt; Webhooks gibt es noch nicht.
# APP_ENCRYPTION_KEY=
# WEBHOOK_SIGNING_SECRET=

# ── Jooble — ein Schlüssel je Land ────────────────────────────
# Ein gemeinsamer Schlüssel für mehrere Länder verletzt die
# Bedingungen der Quelle. Es gibt deshalb keinen Rückfall vom
# Schweizer auf den deutschen Schlüssel.
JOOBLE_API_KEY_DE=
JOOBLE_API_KEY_CH=
JOOBLE_API_KEY_AT=
JOOBLE_KEYWORDS=
JOOBLE_LOCATION=
# Ältere Schreibweise ohne Land. Wird für Deutschland noch gelesen,
# damit bestehende .env-Dateien weiterlaufen. Bitte umstellen.
# JOOBLE_API_KEY=

# ── Adzuna ────────────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=de

# ── Lightcast — ohne Vertrag deaktiviert ──────────────────────
LIGHTCAST_CLIENT_ID=
LIGHTCAST_CLIENT_SECRET=
LIGHTCAST_ENABLED=false

# ── Produkt ───────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_ENV=development
NEXT_PUBLIC_BRAND_NAME=Paycheck
NEXT_PUBLIC_ASSISTANT_NAME=Nina

# ── Aktive Stellenquellen ─────────────────────────────────────
# Komma-getrennt. Eine Quelle läuft nur, wenn sie hier steht UND die
# Policy Engine sie freigibt — die Liste wählt aus, sie erlaubt nicht.
#   arbeitnow            läuft ohne Zugangsdaten
#   adzuna_de, jooble_de brauchen Schlüssel
#   ats_greenhouse, ats_lever, ats_ashby, ats_smartrecruiters
#                        brauchen registrierte Arbeitgeberboards
JOB_SOURCES=arbeitnow,ats_greenhouse,ats_lever,ats_ashby,ats_smartrecruiters

# ── Lokale Entwicklung ohne Supabase ──────────────────────────
# Ohne Supabase-Zugangsdaten läuft eine eingebettete Datenbank. Die
# Oberfläche sagt das ausdrücklich; sie täuscht keine Verbindung vor.
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite
AUTH_SECRET=
AUTH_COOKIE_NAME=paycheck_session

# ── Beobachtbarkeit, optional ─────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=

# ── Unternehmensangaben ───────────────────────────────────────
# Diese Werte erscheinen im Impressum und auf "Über uns". Solange sie
# leer sind, sagt die Seite ausdrücklich, dass sie unvollständig ist —
# ein Platzhalter wie "name@....com" wäre schlimmer als gar nichts.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_STREET=
NEXT_PUBLIC_COMPANY_POSTAL_CODE=
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_COUNTRY=Deutschland
NEXT_PUBLIC_COMPANY_REPRESENTED_BY=
NEXT_PUBLIC_COMPANY_REGISTER_COURT=
NEXT_PUBLIC_COMPANY_REGISTER_NUMBER=
NEXT_PUBLIC_COMPANY_VAT_ID=

# Erst auf "true" setzen, wenn die rechtlichen Rollenbezeichnungen
# bestätigt sind. Eine falsche Rollenangabe im Impressum ist ein
# Rechtsfehler, keine Ungenauigkeit.
NEXT_PUBLIC_TEAM_ROLES_CONFIRMED=false

NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_TIM_CONTACT_EMAIL=
NEXT_PUBLIC_FINN_CONTACT_EMAIL=

# ── E-Mail-Versand ────────────────────────────────────────────
# GEPLANT — noch nicht implementiert. Vor Produktion: eigene Domain
# mit SPF, DKIM und DMARC.
# RESEND_API_KEY=
# EMAIL_FROM_AUTH=
# EMAIL_FROM_PRODUCT=
# EMAIL_REPLY_TO_SUPPORT=
# EMAIL_DOMAIN=
